{
  "name": "premier-league-baseball",
  "version": "1.0.0",
  "description": "",
  "targets": {
    "default": {
      "distDir": "./dist/ui"
    }
  },
  "scripts": {
    "build": "npx parcel build src/ui/index.html --no-cache && tsc",
    "build:clean": "npm run clean && npm run build",
    "build:docker": "docker build -t premier-league-baseball .",
    "clean": "rm -rf dist",
    "start": "node dist/src/index.js",
    "start:docker": "docker run -p 8080:3000 premier-league-baseball",
    "test": "DOTENV_CONFIG_PATH=.env.test DOTENV_CONFIG_OVERRIDE=true node -r dotenv/config ./node_modules/jest/bin/jest.js",
    "test:coverage": "DOTENV_CONFIG_PATH=.env.test DOTENV_CONFIG_OVERRIDE=true node -r dotenv/config ./node_modules/jest/bin/jest.js --coverage",
    "test:single": "DOTENV_CONFIG_PATH=.env.test DOTENV_CONFIG_OVERRIDE=true node -r dotenv/config ./node_modules/jest/bin/jest.js -i",
    "test:bdd": "DOTENV_CONFIG_PATH=.env.test DOTENV_CONFIG_OVERRIDE=true node -r dotenv/config ./node_modules/jest/bin/jest.js test/bdd",
    "test:ui": "DOTENV_CONFIG_PATH=.env.test DOTENV_CONFIG_OVERRIDE=true node -r dotenv/config ./node_modules/jest/bin/jest.js --selectProjects ui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wulke/premier-league-baseball.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/wulke/premier-league-baseball/issues"
  },
  "homepage": "https://github.com/wulke/premier-league-baseball#readme",
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@stitches/react": "^1.2.8",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "radix-ui": "^1.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-router": "^7.1.3",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "jest": "^29.7.0",
    "jest-cucumber": "^4.5.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-express": "^1.12.0",
    "jest-mock-extended": "^4.0.0-beta1",
    "parcel": "^2.13.3",
    "process": "^0.11.10",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "whatwg-fetch": "^3.6.20"
  }
}
