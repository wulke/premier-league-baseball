{
  "name": "premier-league-baseball",
  "version": "1.0.0",
  "description": "",
  "targets": {
    "default": {
      "distDir": "./dist/ui"
    }
  },
  "scripts": {
    "build": "tsc && npx parcel build src/ui/index.html --no-cache",
    "build:clean": "npm run clean && npm run build",
    "build:docker": "docker build -t premier-league-baseball .",
    "clean": "rm -rf dist",
    "start": "nodemon dist/index.js",
    "start:docker": "docker run -p 8080:3000 premier-league-baseball",
    "test": "dotenv -e .env.test -- jest",
    "test:single": "dotenv -e .env.test -- jest -i"
  },
  "alias": {
    "react": "preact/compat",
    "react-dom/test-utils": "preact/test-utils",
    "react-dom": "preact/compat",
    "react/jsx-runtime": "preact/jsx-runtime"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wulke/premier-league-baseball.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/wulke/premier-league-baseball/issues"
  },
  "homepage": "https://github.com/wulke/premier-league-baseball#readme",
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@radix-ui/react-form": "^0.1.1",
    "@radix-ui/react-separator": "^1.1.1",
    "@stitches/react": "^1.2.8",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "preact": "^10.25.4",
    "preact-router": "^4.1.2",
    "react-hook-form": "^7.54.2",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "jest": "^29.7.0",
    "jest-express": "^1.12.0",
    "jest-mock-extended": "^4.0.0-beta1",
    "parcel": "^2.13.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
