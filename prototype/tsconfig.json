{
  "compilerOptions": {
    "target": "ES2020",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "allowUmdGlobalAccess": true,
    "baseUrl": "./"
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
